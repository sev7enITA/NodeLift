{
  "repository": "https://github.com/alex8819/DistAi",
  "commit": "b1c17109498e87b3db99f8f23648d84483b68bb9",
  "assessment_date": "2026-10-31",
  "commits": [
    {
      "sha": "b1c17109498e87b3db99f8f23648d84483b68bb9",
      "date": "2026-10-16T22:17:19Z",
      "message": "Add step-by-step guide for running a 14B model on three phones over USB\n\n- README: enable USB debugging, install the APK, build the PC side, download the model, launch the cluster and generate from the dashboard.\n- tools/video14b.py: fall back to native/build-pc when build-x86c is missing; LLAMA_SERVER overrides the binary."
    },
    {
      "sha": "af2919c05b847ff440b78a26c28cece3234bbd5d",
      "date": "2026-10-16T22:05:36Z",
      "message": "Add cluster view, coordinator stats, language switch and PC dashboard\n\n- App: ClusterView and CoordStats show per-node load and coordinator stats; Lang adds Italian/English UI.\n- tools/dashboard.py + dashboard.html: PC dashboard with real per-phone CPU/RAM and live chat stream.\n- tools/video14b.py: launches a 14B model split evenly over three phones via adb forward (serials from SERIAL_* env vars)."
    },
    {
      "sha": "c97f5d4eadd7a6e5128bd375af36e3a46f8dd05a",
      "date": "2026-10-16T20:47:12Z",
      "message": "Add README banner and third-party license notice"
    },
    {
      "sha": "566dca1012acfba84e2c2257dfb48088d443c793",
      "date": "2026-10-16T20:32:58Z",
      "message": "DistAI: one LLM across several Android phones (first public release)"
    }
  ],
